# VitalGuard Backend Environment Configuration
# Copy this file to .env before running the backend

# --- Security ---
# JWT signing secret (replace with a strong random key in production)
SECRET_KEY=your-super-secret-jwt-key-replace-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Database ---
# SQLite for development (default)
DATABASE_URL=sqlite:///./vitalguard.db
# PostgreSQL example for production:
# DATABASE_URL=postgresql://user:password@localhost:5432/vitalguard

# --- Application ---
APP_ENV=development
DEBUG=True
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Frontend ---
VITE_API_URL=http://localhost:8000
